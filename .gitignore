# Local dev data — holds ha_url/ha_token (secrets). Never commit.
/data/

# LOCAL-ONLY NOTES — machine names, IPs, ports, where credentials live.
# THIS REPO IS PUBLIC. DEV_BENCH.local.md describes Jeremy's own bench and
# network and must never ship. Any *.local.md is private working notes.
*.local.md

# Temporary test-corpus staging artifact — real (scrubbed) piston exports,
# not meant to persist past the hard-testing session that generated it.
/static/pistoncore/_test_corpus_staged.json

# REAL webCoRE BACKUPS — never commit. THIS REPO IS PUBLIC.
# A dashboard backup is the user's whole instance: real device and room names,
# piston names, and (via Hubitat-bridged devices) lock/alarm codes with
# household member names. Work with one in a scratch directory OUTSIDE the
# repo; these patterns are a backstop for when one lands here by accident.
webCoRE.*.zip
webCoRE.*.json
*backup*.json
/backups/
/_private/

# Python
.venv/
__pycache__/
*.pyc

# Node (playwright test scratchpad, if ever run from repo root)
node_modules/
