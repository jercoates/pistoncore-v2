{#- ─ entity_id block, single scalar or list, at a given indent ─ -#}
{%- macro entity_ids(entities, pad) -%}
{%- if entities|length == 1 %}
{{ pad }}entity_id: {{ entities[0] }}
{%- else %}
{{ pad }}entity_id:
{%- for e in entities %}
{{ pad }}  - {{ e }}
{%- endfor %}
{%- endif %}
{%- endmacro -%}

{%- macro trigger_block(t) -%}
{%- if t.kind == 'state' -%}
- trigger: state
{{- entity_ids(t.entities, '  ') }}
{%- if t.get('attribute') %}
  attribute: {{ t.get('attribute') }}
{%- endif %}
{%- if t.get('to') %}
{%- if t.get('to') is not sequence or t.get('to') is string %}
  to: "{{ t.get('to') }}"
{%- else %}
  to:
{%- for v in t.get('to') %}
    - "{{ v }}"
{%- endfor %}
{%- endif %}
{%- endif %}
{%- if t.get('from') %}
{%- if t.get('from') is not sequence or t.get('from') is string %}
  from: "{{ t.get('from') }}"
{%- else %}
  from:
{%- for v in t.get('from') %}
    - "{{ v }}"
{%- endfor %}
{%- endif %}
{%- endif %}
{%- elif t.kind == 'numeric_state' -%}
- trigger: numeric_state
{{- entity_ids(t.entities, '  ') }}
{%- if t.get('attribute') %}
  attribute: {{ t.get('attribute') }}
{%- endif %}
{%- if t.get('above') is not none %}
  above: {{ t.get('above') }}
{%- endif %}
{%- if t.get('below') is not none %}
  below: {{ t.get('below') }}
{%- endif %}
{%- if t.get('for') %}
  for: "{{ t.get('for') }}"
{%- endif %}
{%- elif t.kind == 'template' -%}
- trigger: template
  value_template: "{{ t.template }}"
{%- if t.get('for') %}
  for: "{{ t.get('for') }}"
{%- endif %}
{%- elif t.kind == 'sun' -%}
- trigger: sun
  event: {{ t.event }}
{%- if t.get('offset') %}
  offset: "{{ t.get('offset') }}"
{%- endif %}
{%- elif t.kind == 'time' -%}
- trigger: time
  at: "{{ t.at }}"
{%- elif t.kind == 'time_pattern' -%}
- trigger: time_pattern
{%- if t.get('hours') is not none %}
  hours: "{{ t.get('hours') }}"
{%- endif %}
{%- if t.get('minutes') is not none %}
  minutes: "{{ t.get('minutes') }}"
{%- endif %}
{%- if t.get('seconds') is not none %}
  seconds: "{{ t.get('seconds') }}"
{%- endif %}
{%- endif %}
{%- if t.kind == 'state' and t.get('for') %}
  for: "{{ t.get('for') }}"
{%- endif %}
{%- if t.get('id') %}
  id: {{ t.get('id') }}
{%- endif %}
{%- endmacro -%}

{%- macro cond_block(c) -%}
{%- if c.kind == 'template' -%}
- condition: template
  value_template: "{{ c.template }}"
{%- elif c.kind == 'time' -%}
- condition: time
{%- if c.get('after') %}
  after: "{{ c.get('after') }}"
{%- endif %}
{%- if c.get('before') %}
  before: "{{ c.get('before') }}"
{%- endif %}
{#- webCoRE numbers days 0=Sunday..6=Saturday; HA names them. The NAMES live
    here, not in Python, so an HA rename is a template edit (HARD_RULES §8).
    Without this the "only on these weekdays" restriction was emitted nowhere
    at all — device-proven: a piston saying "every day except today" fired. -#}
{%- if c.get('weekday') %}
  weekday:
{%- for d in c.get('weekday') %}
    - {{ ['sun','mon','tue','wed','thu','fri','sat'][d] }}
{%- endfor %}
{%- endif %}
{%- elif c.kind == 'months' -%}
{#- HA has no native month condition, so this is the one place it must be a
    template. webCoRE numbers months 1-12, same as `now().month`. -#}
- condition: template
  value_template: "{{ '{{' }} now().month in {{ c.get('months') | list }} {{ '}}' }}"
{%- elif c.kind == 'sun' -%}
- condition: sun
{%- if c.get('after') %}
  after: {{ c.get('after') }}
{%- endif %}
{%- if c.get('before') %}
  before: {{ c.get('before') }}
{%- endif %}
{%- elif c.kind in ('and', 'or') -%}
- condition: {{ c.kind }}
  conditions:
{%- for k in c.conditions %}
{{ cond_block(k) | indent(4, true) }}
{%- endfor %}
{%- elif c.kind == 'trigger' -%}
- condition: trigger
  id: {{ c.id }}
{%- endif %}
{%- endmacro -%}

{%- macro action_block(a) -%}
{%- if a.kind == 'delay' -%}
{%- if a.get('delay_ms') is not none -%}
- delay:
    milliseconds: {{ a.get('delay_ms') }}
{%- elif a.get('delay_seconds') is not none -%}
- delay:
    seconds: "{{ a.get('delay_seconds') }}"
{%- else -%}
- delay: "{{ a.delay }}"
{%- endif -%}
{%- elif a.kind == 'service' -%}
- action: {{ a.service }}
{%- if a.get('data') %}
  data:
{%- for k, v in a.get('data').items() %}
    {{ k }}: {{ v }}
{%- endfor %}
{%- endif %}
{%- if a.entities %}
  target:
{{- entity_ids(a.entities, '    ') }}
{%- elif a.get('target_template') %}
  target:
    entity_id: "{{ a.target_template }}"
{%- endif %}
{%- elif a.kind == 'variables' -%}
- variables:
{%- for k, v in a.vars.items() %}
    {{ k }}: {{ v }}
{%- endfor %}
{%- elif a.kind == 'choose' -%}
- choose:
{%- for o in a.options %}
    - conditions:
{%- for c in o.conditions %}
{{ cond_block(c) | indent(8, true) }}
{%- endfor %}
      sequence:
{%- if o.sequence %}
{%- for x in o.sequence %}
{{ action_block(x) | indent(8, true) }}
{%- endfor %}
{%- else %}
        []
{%- endif %}
{%- endfor %}
{%- if a.get('default') %}
  default:
{%- for x in a.get('default') %}
{{ action_block(x) | indent(4, true) }}
{%- endfor %}
{%- endif %}
{%- elif a.kind == 'repeat' -%}
- repeat:
{%- if a.get('count') is not none %}
    count: {{ a.get('count') }}
{%- endif %}
{%- if a.get('while') %}
    while:
{%- for c in a.get('while') %}
{{ cond_block(c) | indent(6, true) }}
{%- endfor %}
{%- endif %}
{%- if a.get('until') %}
    until:
{%- for c in a.get('until') %}
{{ cond_block(c) | indent(6, true) }}
{%- endfor %}
{%- endif %}
    sequence:
{%- if a.body %}
{%- for x in a.body %}
{{ action_block(x) | indent(6, true) }}
{%- endfor %}
{%- else %}
      []
{%- endif %}
{%- elif a.kind == 'wait_for_time' -%}
- wait_for_trigger:
    - trigger: time
      at: "{{ a.at }}"
  timeout:
    hours: 25
  continue_on_timeout: true
{%- elif a.kind == 'wait_for_event' -%}
- wait_for_trigger:
{%- for e in a.events %}
    - trigger: event
      event_type: {{ e.event_type }}
      event_data:
        entity_id: {{ e.entity }}
      id: {{ e.id }}
{%- endfor %}
  timeout: "{{ a.timeout }}"
  continue_on_timeout: false
{%- elif a.kind == 'stop' -%}
- stop: "{{ a.get('reason') or 'piston exited' }}"
{%- elif a.kind == 'if' -%}
- if:
{%- for c in a.conditions %}
{{ cond_block(c) | indent(4, true) }}
{%- endfor %}
{%- if a.get('then') %}
  then:
{%- for x in a.get('then') %}
{{ action_block(x) | indent(4, true) }}
{%- endfor %}
{%- else %}
  then: []
{%- endif %}
{%- if a.get('else') %}
  else:
{%- for x in a.get('else') %}
{{ action_block(x) | indent(4, true) }}
{%- endfor %}
{%- endif %}
{%- endif %}
{%- endmacro -%}
- id: {{ auto_id }}
  alias: "{{ alias }}"
  mode: {{ mode }}
{%- if max_exceeded %}
  # Dropped runs are EXPECTED here, not a fault — see the throttle note at the
  # end of this automation. `silent` stops HA logging a warning for each one.
  max_exceeded: {{ max_exceeded }}
{%- endif %}
  triggers:
{%- for t in triggers %}
{{ trigger_block(t) | indent(4, true) }}
{%- endfor %}
{%- if conditions %}
  conditions:
{%- for c in conditions %}
{{ cond_block(c) | indent(4, true) }}
{%- endfor %}
{%- endif %}
{%- if actions or throttle_seconds %}
  actions:
{%- for a in actions %}
{{ action_block(a) | indent(4, true) }}
{%- endfor %}
{%- if throttle_seconds %}
    # THROTTLE. This automation wakes on EVERY update of the watched value,
    # because webCoRE's `remains_*` means "was and still is" — it has to see
    # each change to know that. A fast driver (MQTT especially) can report many
    # times a second, so this trailing wait holds the automation busy and
    # `mode: single` drops anything arriving during it. Without this, a chatty
    # sensor would run the automation continuously.
    #
    # Raise it to make the piston quieter, lower it to make it more responsive.
    # This is a plain HA delay — edit it here and it stays edited until the
    # piston is recompiled.
    - delay: "{{ throttle_seconds }}"
{%- endif %}
{%- else %}
  actions: []
{%- endif %}
